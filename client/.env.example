# Copy to .env and fill in from your Supabase project settings (API section).
# Only the public anon key belongs here — it is safe to ship to the browser
# because Row Level Security enforces access. Never put the service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the Express API.
VITE_API_URL=http://localhost:4000
